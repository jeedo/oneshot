@page
@inject IOptions<FeatureOptions> Features
<h1>OneShot</h1>
<p>Share a secret that can be read exactly once. It is encrypted in your browser before it leaves this page.</p>
<section data-page="create">
    <p>
        <label for="secret">Secret</label><br />
        <textarea id="secret" rows="6" cols="60" autocomplete="off" spellcheck="false" autocapitalize="off"></textarea>
    </p>
    <p>
        <label for="ttl">Expires after</label>
        <select id="ttl">
            <option value="300">5 minutes</option>
            <option value="900">15 minutes</option>
            <option value="3600" selected>1 hour</option>
            <option value="14400">4 hours</option>
            <option value="86400">1 day</option>
            <option value="604800">7 days</option>
        </select>
    </p>
    @if (Features.Value.SplitKeyDelivery)
    {
        <p>
            <label class="checkbox-label"><input type="checkbox" id="splitKey" /> Send the key separately (advanced)</label><br />
            <small>Produces a bare link with no key attached, plus a separate key, so you can send them over two different channels &mdash; for example the link by chat, the key by email. Sending both the same way defeats the point.</small>
        </p>
    }
    <p>
        <button type="button" id="create">Create link</button>
    </p>
    <p id="error" role="alert" hidden></p>
    <div id="result" hidden>
        <p>
            <label for="link">Share link</label><br />
            <input id="link" type="text" readonly size="80" autocomplete="off" />
            <button type="button" id="copy">Copy</button>
        </p>
        @if (Features.Value.SplitKeyDelivery)
        {
            <div id="keyField" hidden>
                <p>
                    <label for="key">Key</label><br />
                    <input id="key" type="text" readonly size="50" autocomplete="off" class="mono" />
                    <button type="button" id="copyKey">Copy key</button>
                </p>
                <p>Send this key over a different channel than the link above.</p>
            </div>
        }
        <p>The link works exactly once. If the recipient reports it was already opened, treat the secret as compromised.</p>
    </div>
</section>
